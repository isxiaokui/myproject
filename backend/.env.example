ZAI_API_KEY=replace-with-your-zhipu-api-key
WEATHER_API_KEY=replace-with-your-apispace-api-key
MULTIMODAL_MODEL=glm-4.5v
MODEL_TIMEOUT_SECONDS=60
CHAT_TOTAL_TIMEOUT_SECONDS=150
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:replace-with-the-same-password-as-root-env@localhost:5432/flower_assistant
REDIS_URL=redis://localhost:6379/0
KNOWLEDGE_CACHE_TTL_SECONDS=900
KNOWLEDGE_CACHE_VERSION=1
AUTH_SECRET_KEY=replace-with-a-random-secret
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
